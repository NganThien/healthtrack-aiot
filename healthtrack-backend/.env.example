PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# ── Supabase Postgres ──────────────────────────────────────────────
# Lấy trong Supabase Dashboard > Project Settings > Database > Connection string
# Dùng "Session pooler" (port 5432) cho service chạy liên tục như bridge này,
# KHÔNG dùng "Transaction pooler" (port 6543) vốn dành cho serverless/edge functions.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Fallback: Postgres local (chỉ dùng khi KHÔNG set DATABASE_URL, vd dev offline) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=health_device
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── MQTT ──────────────────────────────────────────────────────────
HIVEMQ_HOST=broker.hivemq.com
HIVEMQ_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPICS=health/device/node1,health/device/node2

WS_PORT=3001

DEVICE_ID=health_device
DEVICE_NAME=HealthBand Pro
DEVICE_MAC=AA:BB:CC:DD:EE:FF
LATEST_FALL_WINDOW_SECONDS=10
